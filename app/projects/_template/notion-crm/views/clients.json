{
 "database": "clients",
 "source": "Read-only via Notion MCP notion-fetch on 2026-11-14; from a live CRM. Data source ids are not carried and are NOT portable: a deploy creates new ones. View JSON as returned by notion-fetch; displayProperties kept to the columns a person acts on (live views list every column). dataSourceUrl is a placeholder: set it to the new data source.",
 "views": [
  {
   "name": "Today",
   "type": "table",
   "dataSourceUrl": "collection://<data source id>",
   "advancedFilter": {
    "type": "group",
    "operator": "and",
    "filters": [
     {
      "type": "property",
      "property": "Do not contact",
      "propertyType": "checkbox",
      "operator": "checkbox_is_not",
      "value": {
       "type": "exact",
       "value": true
      }
     },
     {
      "type": "group",
      "operator": "or",
      "filters": [
       {
        "type": "property",
        "property": "Follow-up on",
        "propertyType": "date",
        "operator": "date_is_on_or_before",
        "value": {
         "type": "relative",
         "value": "today"
        }
       },
       {
        "type": "property",
        "property": "Waiting since",
        "propertyType": "date",
        "operator": "is_not_empty"
       }
      ]
     },
     {
      "type": "property",
      "property": "Synthetic",
      "propertyType": "checkbox",
      "operator": "checkbox_is_not",
      "value": {
       "type": "exact",
       "value": true
      }
     }
    ]
   },
   "sorts": [
    {
     "property": "Waiting since",
     "direction": "ascending"
    }
   ],
   "displayProperties": [
    "Name",
    "Relationship",
    "Activity",
    "Next step",
    "Follow-up on",
    "Waiting since",
    "Open tasks",
    "Task due",
    "Last two-way contact"
   ]
  },
  {
   "name": "Waiting",
   "type": "table",
   "dataSourceUrl": "collection://<data source id>",
   "advancedFilter": {
    "type": "group",
    "operator": "and",
    "filters": [
     {
      "type": "property",
      "property": "Waiting since",
      "propertyType": "date",
      "operator": "is_not_empty"
     },
     {
      "type": "property",
      "property": "Synthetic",
      "propertyType": "checkbox",
      "operator": "checkbox_is_not",
      "value": {
       "type": "exact",
       "value": true
      }
     }
    ]
   },
   "groupBy": {
    "property": "Waiting band",
    "propertyType": "select",
    "hideEmptyGroups": false,
    "sort": {
     "type": "manual"
    }
   },
   "displayProperties": [
    "Name",
    "Waiting since",
    "Last outbound",
    "Relationship",
    "Next step",
    "Open tasks",
    "Task due"
   ]
  },
  {
   "name": "New leads",
   "type": "table",
   "dataSourceUrl": "collection://<data source id>",
   "advancedFilter": {
    "type": "group",
    "operator": "and",
    "filters": [
     {
      "type": "property",
      "property": "Relationship",
      "propertyType": "select",
      "operator": "enum_is",
      "value": {
       "type": "exact",
       "value": "Lead"
      }
     },
     {
      "type": "property",
      "property": "Created",
      "propertyType": "created_time",
      "operator": "date_is_within",
      "value": {
       "type": "relative",
       "value": "custom",
       "count": 30,
       "direction": "past",
       "unit": "day"
      }
     }
    ]
   },
   "displayProperties": [
