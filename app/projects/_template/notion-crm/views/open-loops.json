{
 "database": "open-loops",
 "source": "Read-only via Notion MCP notion-fetch on 2026-11-14; from a live CRM. Data source ids are not carried and are NOT portable: a deploy creates new ones. View JSON as returned by notion-fetch; displayProperties kept to the columns a person acts on (live views list every column). dataSourceUrl is a placeholder: set it to the new data source.",
 "views": [
  {
   "name": "Owner owes",
   "type": "table",
   "dataSourceUrl": "collection://<data source id>",
   "advancedFilter": {
    "type": "group",
    "operator": "and",
    "filters": [
     {
      "type": "property",
      "property": "Who owes",
      "propertyType": "select",
      "operator": "enum_is",
      "value": {
       "type": "exact",
       "value": "{{owner}}"
      }
     },
     {
      "type": "property",
      "property": "Done",
      "propertyType": "checkbox",
      "operator": "checkbox_is",
      "value": {
       "type": "exact",
       "value": false
      }
     }
    ]
   },
   "sorts": [
    {
     "property": "Due",
     "direction": "ascending"
    }
   ],
   "displayProperties": [
    "Promise",
    "Deal",
    "Done",
    "Due",
    "Overdue",
    "Person",
    "Who owes"
   ]
  },
  {
   "name": "Waiting on others",
   "type": "table",
   "dataSourceUrl": "collection://<data source id>",
   "advancedFilter": {
    "type": "group",
    "operator": "and",
    "filters": [
     {
      "type": "property",
      "property": "Who owes",
      "propertyType": "select",
      "operator": "enum_is",
      "value": [
       {
        "type": "exact",
        "value": "Client"
       },
       {
        "type": "exact",
        "value": "Other"
       }
      ]
     },
     {
      "type": "property",
      "property": "Done",
      "propertyType": "checkbox",
      "operator": "checkbox_is",
      "value": {
       "type": "exact",
       "value": false
      }
     }
    ]
   },
   "displayProperties": [
    "Promise",
    "Deal",
    "Done",
    "Due",
    "Overdue",
    "Person",
    "Who owes"
   ]
  },
  {
   "name": "Overdue",
   "type": "table",
   "dataSourceUrl": "collection://<data source id>",
   "advancedFilter": {
    "type": "group",
    "operator": "and",
    "filters": [
     {
      "type": "property",
      "property": "Overdue",
      "propertyType": "formula",
      "operator": "every",
      "resultFilter": {
       "type": "property",
       "property": "Overdue",
       "propertyType": "checkbox",
       "operator": "checkbox_is",
       "value": {
        "type": "exact",
        "value": true
       }
      }
     }
    ]
   },
   "displayProperties": [
    "Promise",
    "Deal",
    "Done",
    "Due",
    "Overdue",
    "Person",
    "Who owes"
   ]
  }
 ]
}