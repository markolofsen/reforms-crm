{
 "database": "tasks",
 "source": "Read-only via Notion MCP notion-fetch on 2026-11-14; from a live CRM. Data source ids are not carried and are NOT portable: a deploy creates new ones. View JSON as returned by notion-fetch; displayProperties kept to the columns a person acts on (live views list every column). dataSourceUrl is a placeholder: set it to the new data source.",
 "views": [
  {
   "name": "My tasks",
   "type": "table",
   "dataSourceUrl": "collection://<data source id>",
   "advancedFilter": {
    "type": "group",
    "operator": "and",
    "filters": [
     {
      "type": "property",
      "property": "Assignee",
      "propertyType": "person",
      "operator": "person_contains",
      "value": {
       "type": "relative",
       "value": "me"
      }
     },
     {
      "type": "property",
      "property": "Status",
      "propertyType": "status",
      "operator": "status_is_not",
      "value": [
       {
        "type": "is_option",
        "value": "Done"
       },
       {
        "type": "is_option",
        "value": "Cancelled"
       }
      ]
     }
    ]
   },
   "sorts": [
    {
     "property": "Due",
     "direction": "ascending"
    }
   ],
   "displayProperties": [
    "Task",
    "Status",
    "Due",
    "Priority",
    "Assignee",
    "Client",
    "Deal",
    "Area"
   ]
  },
