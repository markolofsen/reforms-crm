{
 "database": "documents",
 "source": "Read-only via Notion MCP notion-fetch on 2026-11-17 from the live saas and realty Documents databases (same four views). View JSON as returned by notion-fetch; the relation column is Clients here (People in the live saas CRM, resolve it by the property alias). dataSourceUrl is a placeholder: set it to the new data source. Column lists follow realty (the fuller list: it also shows the report columns); saas shows the first ten only.",
 "views": [
  {
   "name": "All documents",
   "type": "table",
   "dataSourceUrl": "collection://<data source id>",
   "sorts": [
    {
     "property": "Last edited",
     "direction": "descending"
    }
   ],
   "displayProperties": [
    "Document",
    "Status",
    "Type",
    "Owner",
    "Document link",
    "Files",
    "Clients",
    "Deal",
    "Summary",
    "Last edited",
    "Date",
    "Format",
    "Original participants",
    "Original report",
    "Other participants",
    "Report status",
    "Tasks",
    "Team participants"
   ]
  },
  {
   "name": "Current",
   "type": "table",
   "dataSourceUrl": "collection://<data source id>",
   "advancedFilter": {
    "type": "group",
    "operator": "and",
    "filters": [
     {
      "type": "property",
      "property": "Status",
      "propertyType": "select",
      "operator": "enum_is",
      "value": {
       "type": "exact",
       "value": "Current"
      }
     }
    ]
   },
   "displayProperties": [
    "Document",
    "Type",
    "Owner",
    "Document link",
    "Files",
    "Clients",
    "Deal",
    "Status",
    "Summary",
    "Last edited",
    "Date",
    "Format",
    "Original participants",
    "Original report",
    "Other participants",
    "Report status",
    "Tasks",
    "Team participants"
   ],
   "note": "filter operator enum_is on a select Status (saas and a fresh deploy); realty's Status is type status and uses operator status_is with value {type: is_option, value: Current}"
  },
  {
   "name": "By type",
   "type": "table",
   "dataSourceUrl": "collection://<data source id>",
   "groupBy": {
    "property": "Type",
    "propertyType": "select",
    "sort": {
     "type": "manual"
    }
   },
   "displayProperties": [
    "Document",
    "Status",
    "Type",
    "Owner",
    "Document link",
    "Clients",
    "Deal",
    "Files",
    "Summary",
    "Last edited",
    "Date",
    "Format",
    "Original participants",
    "Original report",
    "Other participants",
    "Report status",
    "Tasks",
    "Team participants"
   ]
  },
  {
   "name": "Reports",
   "type": "table",
   "dataSourceUrl": "collection://<data source id>",
   "advancedFilter": {
    "type": "group",
    "operator": "and",
    "filters": [
     {
      "type": "property",
      "property": "Type",
      "propertyType": "select",
      "operator": "enum_is",
      "value": {
       "type": "exact",
       "value": "Report"
      }
     }
    ]
   },
   "sorts": [
    {
     "property": "Date",
     "direction": "descending"
    }
   ],
   "displayProperties": [
    "Document",
    "Date",
    "Report status",
    "Format",
    "Team participants",
    "Other participants",
    "Clients",
    "Deal",
    "Tasks",
    "Summary",
    "Document link",
    "Files",
