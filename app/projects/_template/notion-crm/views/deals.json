  {
   "name": "Buyers",
   "type": "board",
   "dataSourceUrl": "collection://<data source id>",
   "advancedFilter": {
    "type": "group",
    "operator": "and",
    "filters": [
     {
      "type": "property",
      "property": "Pipeline",
      "propertyType": "select",
      "operator": "enum_is",
      "value": [
       {
        "type": "exact",
        "value": "Buyers"
       }
      ]
     },
     {
      "type": "property",
      "property": "Stage",
      "propertyType": "select",
      "operator": "enum_is_not",
      "value": [
       {
        "type": "exact",
        "value": "Closed"
       },
       {
        "type": "exact",
        "value": "Lost"
       },
       {
        "type": "exact",
        "value": "Not qualified"
       },
       {
        "type": "exact",
        "value": "Withdrawn"
       },
       {
        "type": "exact",
        "value": "Expired"
       },
       {
        "type": "exact",
        "value": "Inactive"
       }
      ]
     }
    ]
   },
   "groupBy": {
    "property": "Stage",
    "propertyType": "select",
    "hideEmptyGroups": true,
    "sort": {
     "type": "manual"
    }
   },
   "displayProperties": [
    "Title",
    "Client",
    "Task due"
