{
 "database": "workflows",
 "title": "Workflows",
 "source": "Read-only via Notion MCP notion-fetch on 2026-11-14; from a live CRM. Data source ids are not carried and are NOT portable: a deploy creates new ones.",
 "properties": {
  "Workflow": {
   "type": "title",
   "writer": "people"
  },
  "Description": {
   "type": "text",
   "writer": "people"
  },
  "Status": {
   "type": "select",
   "options": [
    "Draft",
    "Active",
    "Retired"
   ],
   "writer": "people"
  },
  "Run mode": {
   "type": "select",
   "options": [
    "Manual",
    "Agent may pick",
    "Automatic"
   ],
   "writer": "people"
  },
  "Applies to": {
   "type": "multi_select",
   "options": [
    "Lead",
    "Client",
    "Deal",
    "Partner",
    "Task"
   ],
   "writer": "people"
  },
  "Owner": {
   "type": "person",
   "writer": "people"
  },
  "Last reviewed": {
   "type": "date",
   "writer": "people"
  },
  "Files": {
   "type": "file",
   "writer": "people"
  },
  "Created by": {
   "type": "created_by",
   "writer": "system"
  }
 },
 "pageTemplates": [
  "New workflow"
 ]
}