{
  "database": "documents",
  "title": "Documents",
  "source": "Read-only via Notion MCP notion-fetch on 2026-11-14; from a live CRM. Data source ids are not carried and are NOT portable: a deploy creates new ones.",
  "properties": {
    "Document": {
      "type": "title",
      "writer": "people"
    },
    "Type": {
      "type": "select",
      "writer": "people",
      "options": [
        "Reference",
        "Spec",
        "Procedure",
        "Brief",
        "Contract / legal",
        "SEO",
        "Other"
      ]
    },
    "Status": {
      "type": "status",
      "createAs": "select",
      "groups": {
        "to_do": [
          "Draft"
        ],
        "in_progress": [
          "Review"
        ],
        "complete": [
          "Current",
          "Superseded"
        ]
      },
      "trap": 1,
      "writer": "people"
    },
    "Summary": {
      "type": "text",
      "writer": "people"
    },
    "Owner": {
      "type": "person",
      "writer": "people"
    },
    "Document link": {
      "type": "url",
      "writer": "people"
    },
    "Files": {
      "type": "file",
      "writer": "people"
    },
    "Last edited": {
      "type": "last_edited_time",
      "writer": "system"
    },
    "Clients": {
      "type": "relation",
      "target": "clients",
      "note": "optional, one-way; the live CRMs still call this relation People (the People to Clients rename was not applied live)",
      "aliases": [
        "People"
      ]
    },
    "Deal": {
      "type": "relation",
      "target": "deals",
      "note": "optional, one-way, not limited to one on this database"
    },
    "Tasks": {
      "type": "relation",
      "target": "tasks",
      "reverse": "Documents",
      "note": "two-way; reverse Tasks.Documents (changes the Tasks schema)"
    }
  },
  "noteVsPack": "Live Status is type status (trap 1). Type options SEO is the owner's."
}
