{
  "name": "@hub/installer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Idempotent installer and doctor for the local Hub Workflow (macOS).",
  "engines": {
    "node": ">=22.20"
  },
  "scripts": {
    "hub": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@clack/prompts": "1.9.0",
    "@hub/agent": "workspace:*",
    "@hub/config": "workspace:*",
    "@hub/connections": "workspace:*",
    "@hub/db": "workspace:*",
    "@hub/mail-filters": "workspace:*",
    "@hub/projects": "workspace:*",
    "@hub/send": "workspace:*",
    "@hub/sequences": "workspace:*",
    "commander": "15.1.0",
    "execa": "10.2.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "bin": {
    "hub": "./bin/hub.mjs"
  }
}
