# Working state and every secret stay out of git (the instance is a private repo, but secrets never go in it)
state/*
!state/.gitkeep
state/secrets/
data/
*.db
*.db-wal
*.db-shm
*.db-journal
.env
.env.*
*.pem
*.key
.DS_Store

# Written by `hub setup` / `hub agent`, regenerated every run
.mcp.json
.mcp.json.bak
.claude/skills/
config/config.json

# Derived from hand-written files or from client mail (Gmail import files hold real client addresses)
projects/*/.generated/
projects/*/dumps/
projects/*/knowledge/notion/
projects/*/reports/

# The pinned core, once added as a submodule, is tracked as a gitlink only
config/mcp.json

# Snapshots of `hub backup` hold client data: never in git
backups/

# Dependencies and build output: per Mac, never in git and never on a synced drive (decision 0043)
node_modules/
.turbo/
.next/
