{
  "mcpServers": {
    "mail-mcp": {
      "type": "http",
      "url": "http://localhost:8787"
    },
    "notion": {
      "type": "http",
      "url": "https://mcp.notion.com/mcp"
    },
    "hub": {
      "type": "stdio",
      "command": "node",
      "args": [
        "app/apps/installer/bin/hub.mjs",
        "mcp"
      ],
      "env": {
        "HUB_PROJECT": "${HUB_PROJECT:-}"
      }
    }
  }
}
