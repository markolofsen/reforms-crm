{
  "extends": "@hub/config/tsconfig.dom.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "incremental": true,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "src",
    "test",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next/dev",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "test/**/*.test.ts",
    "test/**/*.test.tsx"
  ]
}
