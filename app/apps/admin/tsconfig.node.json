{
  "extends": "@hub/config/tsconfig.dom.json",
  "compilerOptions": {
    "types": [
      "node"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "eslint.config.mjs",
    "e2e",
    "test/**/*.test.ts",
    "test/**/*.test.tsx",
    "src/**/*.test.ts",
    "src/**/*.test.tsx"
  ]
}
