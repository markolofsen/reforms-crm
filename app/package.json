{
  "name": "reforms-hub-app",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "start": "turbo run start",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test && vitest run --dir test",
    "storybook": "pnpm --filter @hub/storybook storybook",
    "storybook:typecheck": "pnpm --filter @hub/storybook typecheck",
    "storybook:build": "pnpm --filter @hub/storybook build",
    "db:generate": "pnpm --filter @hub/db generate",
    "db:seed": "pnpm --filter @hub/db seed",
    "db:migrate": "pnpm --filter @hub/db migrate",
    "hub": "pnpm --filter @hub/installer hub",
    "e2e": "pnpm --filter @hub/admin e2e",
    "live": "bash scripts/live.sh",
    "test:boundaries": "vitest run --dir test"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "turbo": "2.11.11",
    "typescript": "6.0.3",
    "vitest": "catalog:"
  }
}
