{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": ["HUB_HOME", "HUB_PROJECTS", "HUB_DB", "HUB_CONFIG_DIR", "HUB_CONFIG_FILE", "HUB_ADMIN_PORT", "HUB_PORT", "HUB_NEXT_ROOT", "HUB_NEXT_DIST", "HUB_OPENER", "HUB_AUTOSTART", "HUB_LLM", "OPENROUTER_API_KEY"],
  "tasks": {
    "dev": { "cache": false, "persistent": true },
    "typecheck": { "dependsOn": ["^typecheck"], "outputs": [] },
    "test": { "outputs": [] },
    "build": {
      "dependsOn": ["^build"],
      "env": ["HUB_PORT", "HUB_NEXT_DIST", "HUB_NEXT_ROOT"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/contract/**", "$TURBO_ROOT$/packages/config/**", "$TURBO_ROOT$/packages/ui/**"],
      "outputs": ["dist/**", ".next/**", "storybook-static/**", "!.next/cache/**"]
    },
    "start": { "dependsOn": ["build"], "cache": false, "persistent": true }
  }
}
