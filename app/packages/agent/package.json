    "./detect": "./src/detect.ts",
    "./focus": "./src/focus/index.ts",
    "./mcp": "./src/mcp/server.ts",
    "./session-rules": "./src/session-rules.ts",
    "./mcp-stdio": "./src/mcp/stdio.ts",
    "./mail": "./src/mail/index.ts",
    "./mail/fake": "./src/mail/fake.ts",
    "./records": "./src/records/checks.ts",
    "./messenger-rules": "./src/messenger/rules.ts",
    "./owner-word": "./src/messenger/owner-word.ts",
    "./send-token": "./src/messenger/send-token.ts",
    "./connectors": "./src/connectors.ts",
    "./connector-guard": "./src/connector-guard.ts",
    "./connector-checks": "./src/connector-checks.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
