{
  "name": "@hub/notion",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only Notion dump and restore dry-run for reforms-crm",
  "type": "module",
  "bin": {
    "notion-dump": "./src/cli.ts"
  },
  "scripts": {
    "notion-dump": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hub/config": "workspace:*",
    "@hub/projects": "workspace:*",
    "@notionhq/client": "5.31.1"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "exports": {
    ".": "./src/read.ts"
  }
}
