{
  "name": "@hub/notion",
  "version": "0.1.0",
  "private": true,
  "description": "Notion dump and restore dry-run for reforms-crm: read only, except the two Last sent fields of ./stamp (P89) and the lead Status, Client and new Clients card of ./leads-write (P97)",
  "type": "module",
  "bin": {
    "notion-dump": "./src/cli.ts"
  },
  "scripts": {
    "notion-dump": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hub/config": "workspace:*",
    "@hub/log": "workspace:*",
    "@hub/projects": "workspace:*",
    "@notionhq/client": "5.31.1"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "exports": {
    ".": "./src/read.ts",
    "./stamp": "./src/stamp.ts",
    "./leads-write": "./src/lead-convert.ts"
  }
}
