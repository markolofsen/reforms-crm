{
  "name": "@hub/knowledge",
  "version": "0.1.0",
  "private": true,
  "description": "Per-project knowledge: markdown entries, Notion dump import, SQLite FTS5 index, and the search behind hub mcp's knowledge_search / knowledge_get",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./search": "./src/search.ts"
  },
  "scripts": {
    "knowledge": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hub/config": "workspace:*",
    "@hub/db": "workspace:*",
    "@hub/projects": "workspace:*",
    "commander": "15.1.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
