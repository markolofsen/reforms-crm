{
  "name": "@hub/watch",
  "version": "0.1.0",
  "private": true,
  "description": "P144: the public-chat watcher's machinery. An instance supplies a lens (a declaration: a window task, facets, labels); the core loads it, reads public groups through a narrow PublicReader, stores messages and moments in its own database file per project, and runs the window analysis through @hub/llm.",
  "type": "module",
  "exports": {
    "./config": "./src/config.ts",
    "./policy": "./src/policy.ts",
    "./account-state": "./src/reader/account-state.ts",
    "./lens": "./src/lens/load.ts",
    "./store": "./src/store/repo.ts",
    "./analyse": "./src/analyse/job.ts",
    "./reader": "./src/reader/poller.ts",
    "./import": "./src/store/import.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@hub/config": "workspace:*",
    "@hub/contract": "workspace:*",
    "@hub/db": "workspace:*",
    "@hub/llm": "workspace:*",
    "@hub/log": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
