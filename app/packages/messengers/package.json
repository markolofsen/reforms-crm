{
  "name": "@hub/messengers",
  "version": "0.1.0",
  "private": true,
  "description": "Messengers in the local CRM: Telegram bot on long polling, stored messages, client identifiers, one history with mail, draft-only sending",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./human": "./src/human.ts"
  },
  "scripts": {
    "messengers": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hub/config": "workspace:*",
    "@hub/db": "workspace:*",
    "@hub/mail": "workspace:*",
    "commander": "15.1.0",
    "grammy": "1.46.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
